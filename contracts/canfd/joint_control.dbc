BO_ 0 SyncFrame: 8 JETSON_MASTER
 SG_ sync_marker : 0|8@0+ (1,0) [0|255] ""  SHOULDER_L,SHOULDER_R,ELBOW_L,ELBOW_R,WRIST_L,WRIST_R
 SG_ time_low : 16|16@0+ (0.01,0) [0|327.67] "s" SHOULDER_L,SHOULDER_R,ELBOW_L,ELBOW_R,WRIST_L,WRIST_R
